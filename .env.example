# Nebius Token Factory. Get a key: https://tokenfactory.nebius.com
# Claim hackathon credits ($25 + $25) before you start:
#   https://nebiusglobalaihackathon.devpost.com/resources
NEBIUS_API_KEY=

# Optional. Defaults to the global host; the regional alternate is
# https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Comma-separated FALLBACK CHAINS, tried left to right.
# Token Factory deprecates model IDs with no automatic rerouting, so never
# hardcode a single ID. Run `npm run check:models` to get the authoritative
# list from your account and paste the real IDs here.
MODEL_EXTRACT=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3-super-120b-a12b
MODEL_RECONCILE=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-30b-a3b
MODEL_EMBED=Qwen/Qwen3-Embedding-8B,BAAI/bge-en-icl
MODEL_RERANK=Qwen/Qwen3-Reranker-4B

# Tavily counterparty enrichment (Best Use of Tavily bonus). https://tavily.com
TAVILY_API_KEY=

# Set to 1 locally / at build time to write responses into data/cache.
# Leave unset in production: Vercel's filesystem is read-only and the
# committed cache is what keeps the demo alive if a model is deprecated.
NEBIUS_CACHE_WRITE=
