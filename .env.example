# Nebius Token Factory. Get a key: https://tokenfactory.nebius.com
# Claim hackathon credits ($25 + $25) before you start:
#   https://nebiusglobalaihackathon.devpost.com/resources
NEBIUS_API_KEY=

# Optional. Defaults to the global host; the regional alternate is
# https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Comma-separated FALLBACK CHAINS, tried left to right.
# Token Factory deprecates model IDs with no automatic rerouting, so never
# hardcode a single ID. Run `npm run check:models` to get the authoritative
# list from your account and paste the real IDs here.
MODEL_GATE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_RECONCILE=nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_DRAFT=nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# Permission to make a model call that is not already in the committed response
# cache, and therefore costs money. Leave UNSET and there is no gate at all,
# which is what local development and `npm run prewarm` want.
#
# Set it in production. The two API routes are public and Nebius offers no way to
# bound spending from their side: a budget alerts but "does not stop or cap your
# usage", a key's rate limit cannot be lowered by its owner, and this account
# allows 100 requests a second. Cached answers stay open to everyone; only a
# request that would go over the wire needs this. Put the value in the
# submission's testing instructions so a reviewer can watch a live call.
KEPT_DEMO_TOKEN=

# Tavily counterparty enrichment (Best Use of Tavily bonus). https://tavily.com
TAVILY_API_KEY=

# Where cached responses are read from and written to. Leave unset for
# data/cache, the committed demo cache. Optimization runs set this to
# loop/.cache so they cannot bloat it - see loop/PROJECT.md.
NEBIUS_CACHE_DIR=

# Set to 1 locally / at build time to write responses into the cache.
# Leave unset in production: Vercel's filesystem is read-only and the
# committed cache is what keeps the demo alive if a model is deprecated.
NEBIUS_CACHE_WRITE=
